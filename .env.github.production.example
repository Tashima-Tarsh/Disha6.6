# Node 22 production with individual password accounts.
# Run configure-production.mjs to generate private Compose configuration.
NODE_ENV=production
DISHA_AUTH_MODE=password
DISHA_JWT_SECRET=<random-secret-from-configure-production>
DISHA_WORKER_TOKEN=<random-secret-from-configure-production>
POSTGRES_PASSWORD=<url-safe-database-password>
DATABASE_URL=<postgresql-connection-url>
REDIS_URL=<redis-connection-url>
DISHA_PRODUCTION_URL=https://disha6.6.thenitishkr.in
NEXT_PUBLIC_APP_URL=https://disha6.6.thenitishkr.in
DISHA_ALLOWED_ORIGINS=https://disha6.6.thenitishkr.in
# Cloudflare Worker variable: the distinct HTTPS hostname of the Node server.
DISHA_ORIGIN_URL=<https-origin-host>
# Only enable when your ingress replaces forwarded IP headers and direct access is blocked.
DISHA_TRUST_PROXY=false
DISHA_WORKSPACE_ROOT=/data/workspaces
DISHA_BRAIN_URL=http://disha-brain:8080
DISHA_BRAIN_API_TOKEN=<strong-random-token>
DISHA_RESEARCH_RUNTIME_URL=http://disha-brain:8080
DISHA_RESEARCH_RUNTIME_TOKEN=<same-brain-api-token>
DISHA_MODEL_PROVIDER=disabled
# Set up an account using auth:create-user. DISHA_DEV_PASSWORD has no production effect.
# Alternative managed identity: DISHA_AUTH_MODE=oidc and the following values:
# DISHA_OIDC_ISSUER=https://your-issuer
# DISHA_OIDC_CLIENT_ID=
# DISHA_OIDC_CLIENT_SECRET=
# DISHA_OIDC_REDIRECT_URI=https://disha6.6.thenitishkr.in/api/auth/oidc/callback
# DISHA_OIDC_ALLOWED_EMAILS=
# DISHA_OIDC_ADMIN_EMAILS=
# DISHA_INTRA_ID_AUTH_URL=https://your-provider/authorize
