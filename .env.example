# DISHA environment variables
# Copy this file to .env and replace every <...> placeholder before deployment.
# Do not commit real keys, tokens, passwords, private endpoints, or production secrets.

# Layer 1: Governed Intelligence Core (default production spine)
NODE_ENV=development
DATABASE_URL=postgresql://disha:<set-postgres-password>@localhost:5432/disha
REDIS_URL=redis://localhost:6379
DISHA_WORKER_TOKEN=<set-at-least-24-random-characters>
DISHA_SCHEDULER_POLL_SECONDS=30
DISHA_RUNTIME_EVENT_STREAM=disha:runtime-events
POSTGRES_PASSWORD=<set-postgres-password>
DISHA_AUTH_MODE=dev-jwt
DISHA_JWT_SECRET=<set-at-least-32-random-characters>
DISHA_DEV_PASSWORD=<set-local-password>
DISHA_DEV_ADMIN_EMAILS=

# Meri Pehchaan / DigiLocker Auth partner SSO.
# Obtain DISHA's client ID/secret through https://dlpartners.meripehchaan.gov.in/welcome/
DISHA_MERI_PEHCHAN_AUTH_URL=https://digilocker.meripehchaan.gov.in/public/oauth2/1/authorize
DISHA_MERI_PEHCHAN_TOKEN_URL=https://digilocker.meripehchaan.gov.in/public/oauth2/2/token
DISHA_MERI_PEHCHAN_USER_URL=https://digilocker.meripehchaan.gov.in/public/oauth2/1/user
DISHA_MERI_PEHCHAN_CLIENT_ID=<set-issued-client-id>
DISHA_MERI_PEHCHAN_CLIENT_SECRET=<set-issued-client-secret>
DISHA_MERI_PEHCHAN_REDIRECT_URI=http://localhost:3000/api/auth/oidc/callback
DISHA_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/oidc/callback
DISHA_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Governed model intelligence layer
# disabled keeps local and CI deterministic. Set to anthropic or openai only on the server.
DISHA_MODEL_PROVIDER=disabled
DISHA_MODEL_TIMEOUT_MS=20000
ANTHROPIC_API_KEY=<set-anthropic-api-key>
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_VERSION=2023-06-01
OPENAI_API_KEY=<set-openai-api-key>
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional live model router. Prefer setting this via /api/v1/runtime/model-routes in production.
# Each route references an API key ENV NAME; secrets never belong in the JSON.
DISHA_MODEL_ROUTES_JSON=
DISHA_MODEL_ROLE=analysis

# Layer 2: Sovereign Cognitive Extensions (optional, Docker --profile full)
DISHA_BRAIN_API_HOST=127.0.0.1
DISHA_BRAIN_API_PORT=8080
DISHA_BRAIN_API_TOKEN=<set-disha-brain-api-token>
DISHA_BRAIN_DB_PATH=./data/disha_brain.db
DISHA_BRAIN_URL=
DISHA_RESEARCH_RUNTIME_URL=
DISHA_RESEARCH_RUNTIME_TOKEN=<set-governed-research-runtime-token>
DISHA_RESEARCH_RUNTIME_TIMEOUT_MS=2500
DISHA_WORKSPACE_ROOT=.

# Optional research service endpoints used by DISHA Brain adapters
DISHA_AI_PLATFORM_URL=http://127.0.0.1:8000/api/v1
DISHA_MCP_HTTP_URL=http://127.0.0.1:4000
DISHA_PHYSICS_URL=http://127.0.0.1:8002
DISHA_OPENCANARY_URL=http://127.0.0.1:8081

# AI Platform Backend (research profile)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<set-neo4j-password>
CHROMA_HOST=chromadb
CHROMA_PORT=8000
SECRET_KEY=<set-jwt-secret>
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Cyber Defense
COWRIE_SSH_PORT=2222
OPENCANARY_HTTP_PORT=8081
ELASTIC_PORT=9200

# Physics Engine
NASA_API_KEY=<set-nasa-api-key-or-demo-key>
PHYSICS_API_PORT=8002

# Optional CLI feature flags. Set to 1 or true to enable.
# CLAUDE_CODE_BRIDGE_MODE=0
# CLAUDE_CODE_DAEMON=0
# CLAUDE_CODE_VOICE_MODE=0
# CLAUDE_CODE_BG_SESSIONS=0

# Edge agent
DISHA_BRAIN_BACKEND_URL=http://127.0.0.1:8080
DISHA_BRAIN_DEVICE_ID=desktop
DISHA_BRAIN_USER_ID=local-user
DISHA_BRAIN_AGENT_INTERVAL=15

# Public-data adapter identification/contact (no secrets)
SEC_USER_AGENT=DISHA/6.6 contact@example.org
OPENALEX_MAILTO=contact@example.org

# Public entity/corporate enrichment
OPENSANCTIONS_API_KEY=
OPENCORPORATES_API_TOKEN=

# Service-backed CTI/OSINT platforms.
# Point these to operator-controlled OpenCTI / IntelOwl deployments.
OPENCTI_BASE_URL=
OPENCTI_TOKEN=
INTELOWL_BASE_URL=
INTELOWL_API_KEY=
# Explicit analyzer allowlist only; DISHA never requests every analyzer.
INTELOWL_ANALYZERS=Classic_DNS,WhoIs_RipeDB_Search

# Defensive public CTI enrichment (Auth-Keys from the respective abuse.ch community services)
THREATFOX_AUTH_KEY=
MALWAREBAZAAR_AUTH_KEY=

# Configured CTI service adapters.
# OpenCTI is queried read-only. IntelOwl accepts observables only and runs analyzer
# names listed here; do not include detonation, file-submission, or active-scanning analyzers.
OPENCTI_BASE_URL=
OPENCTI_TOKEN=
INTELOWL_BASE_URL=
INTELOWL_API_KEY=
INTELOWL_ANALYZERS_ALLOWLIST=
INTELOWL_JOB_TIMEOUT_MS=40000

# Governed ASTRA 6 OSINT workers
# Enable only tools whose isolated worker image is actually deployed.
DISHA_ASTRA6_ALL_TOOLS_ENABLED=false
DISHA_ASTRA6_PHONEINFOGA_ENABLED=false
DISHA_ASTRA6_SHERLOCK_ENABLED=false
DISHA_ASTRA6_THEHARVESTER_ENABLED=false
DISHA_ASTRA6_SPIDERFOOT_ENABLED=false
DISHA_ASTRA6_RECON_NG_ENABLED=false
DISHA_ASTRA6_PHOTON_ENABLED=false
DISHA_ASTRA6_OWASP_AMASS_ENABLED=false
DISHA_ASTRA6_SUBFINDER_ENABLED=false
# Required in addition to a tool flag for email/phone/username enumeration routes.
DISHA_IDENTITY_ENUMERATION_APPROVED=false
# Photon is a bounded direct crawler; requires deployment approval plus an operator/admin checkbox per investigation.
DISHA_ACTIVE_RECON_APPROVED=false
DISHA_OSINT_POLL_MS=3000
DISHA_ASTRA6_QUEUE_TIMEOUT_MS=45000

# Dynamic retrieval/workflow plane
DISHA_EMBEDDING_PROVIDER=openai-compatible
DISHA_EMBEDDING_BASE_URL=http://embeddings:80/v1
DISHA_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
DISHA_EMBEDDING_TIMEOUT_MS=3000
DISHA_EMBEDDING_API_KEY=
DISHA_WORKFLOW_LEASE_SECONDS=120
DISHA_WORKFLOW_MAX_JOBS=10
DISHA_WORKER_ID=dynamic-worker-1


# Governed OSINT worker plane
# Public username/email/phone enumeration is disabled until the operator explicitly
# confirms an authorized investigation purpose.
DISHA_IDENTITY_ENUMERATION_APPROVED=false
DISHA_ASTRA6_SHERLOCK_ENABLED=true
DISHA_ASTRA6_MAIGRET_ENABLED=true
DISHA_ASTRA6_HOLEHE_ENABLED=true
DISHA_ASTRA6_PHONEINFOGA_ENABLED=true
DISHA_ASTRA6_INSTALOADER_ENABLED=true
DISHA_ASTRA6_TELEGRAM_PUBLIC_ENABLED=true
DISHA_OSINT_POLL_MS=1000
DISHA_MAIGRET_TOP_SITES=300
DISHA_HOLEHE_TIMEOUT_SECONDS=8
DISHA_SHERLOCK_TIMEOUT_SECONDS=10

# Optional authenticated public-source connectors.
# TELEGRAM_SESSION must be a Telethon StringSession created by the operator for
# an account they are authorized to use. Never commit session strings.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# Optional Instaloader session. Public profiles can be queried without these,
# but Instagram may rate-limit anonymous requests.
INSTAGRAM_LOGIN=
INSTAGRAM_SESSION_FILE=
