# DISHA 6.6 — Constitutional Evidence Operating System
# Production environment configuration.
#
# Copy this file to .env.local (development) or .env.production and fill in
# every value before deploying. Never commit real secrets to version control.
# Server-only secrets must never be exposed to the browser (no NEXT_PUBLIC
# prefix unless the value is intentionally public).

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=8000
DISHA_BUILD_SHA=

# ---------------------------------------------------------------------------
# Authentication (required)
# ---------------------------------------------------------------------------
# dev-jwt | password | oidc | hybrid. dev-jwt is forbidden in production.
DISHA_AUTH_MODE=password
# JWT access-token signing secret. Minimum 32 characters. Required in production.
DISHA_JWT_SECRET=replace-with-a-32-character-plus-random-secret
# Local dev password login (required when DISHA_AUTH_MODE=dev-jwt).
DISHA_DEV_PASSWORD=replace-with-a-strong-dev-password
# Comma-separated admin emails allowed to log in during dev.
DISHA_DEV_ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# OIDC / Meri Pehchaan (DigiLocker) — required when DISHA_AUTH_MODE=oidc
# ---------------------------------------------------------------------------
DISHA_OIDC_ISSUER=
DISHA_OIDC_CLIENT_ID=
DISHA_OIDC_CLIENT_SECRET=
DISHA_OIDC_REDIRECT_URI=
DISHA_MERI_PEHCHAN_AUTH_URL=https://digilocker.meripehchaan.gov.in/public/oauth2/1/authorize
DISHA_MERI_PEHCHAN_TOKEN_URL=https://digilocker.meripehchaan.gov.in/public/oauth2/2/token
DISHA_MERI_PEHCHAN_USER_URL=https://digilocker.meripehchaan.gov.in/public/oauth2/1/user
DISHA_MERI_PEHCHAN_CLIENT_ID=
DISHA_MERI_PEHCHAN_CLIENT_SECRET=
DISHA_MERI_PEHCHAN_REDIRECT_URI=

# ---------------------------------------------------------------------------
# Persistence (required in production unless DISHA_ALLOW_STATELESS_AUTH=true)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://disha:password@localhost:5432/disha
REDIS_URL=redis://localhost:6379
DISHA_WORKSPACE_ROOT=.

# ---------------------------------------------------------------------------
# CORS & public URL
# ---------------------------------------------------------------------------
# Comma-separated list of origins allowed to call the API. Required in production.
DISHA_ALLOWED_ORIGINS=https://disha.your-domain.com
NEXT_PUBLIC_APP_URL=https://disha.your-domain.com
DISHA_BACKEND_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# DISHA Brain (Python research runtime) — optional, read-only governed adapter
# ---------------------------------------------------------------------------
DISHA_BRAIN_URL=http://localhost:8000
DISHA_RESEARCH_RUNTIME_URL=
DISHA_RESEARCH_RUNTIME_TOKEN=
DISHA_RESEARCH_RUNTIME_TIMEOUT_MS=2500
DISHA_BRAIN_API_TOKEN=

# ---------------------------------------------------------------------------
# Rate limiting & evidence ledger
# ---------------------------------------------------------------------------
DISHA_WEB_RATE_LIMIT=120
DISHA_EVIDENCE_LEDGER_MODE=postgres
DISHA_ALLOW_STATELESS_AUTH=false

# ---------------------------------------------------------------------------
# Agent & workflow
# ---------------------------------------------------------------------------
DISHA_AGENT_MODE=balanced
DISHA_AGENT_INPUT_BUDGET_TOKENS=8000
DISHA_AGENT_CACHE_TTL_SECONDS=3600
DISHA_AGENT_MAX_CACHE_BYTES=250000
DISHA_WORKFLOW_NODE_TIMEOUT_MS=15000
DISHA_WORKFLOW_TOTAL_TIMEOUT_MS=60000
DISHA_WORKFLOW_ALLOWED_HOSTS=
DISHA_WORKFLOW_LEASE_SECONDS=120
# Internal scheduler/worker calls. Required in production (min 24 chars).
DISHA_WORKER_TOKEN=replace-with-a-24-character-plus-random-worker-token

# ---------------------------------------------------------------------------
# Models & embeddings
# ---------------------------------------------------------------------------
DISHA_MODEL_PROVIDER=disabled
DISHA_MODEL_ROUTES_JSON=
DISHA_MODEL_ROLE=analysis
DISHA_MODEL_TIMEOUT_MS=60000
DISHA_LOCAL_ONLY_MODE=false
DISHA_EMBEDDING_PROVIDER=local-hash
DISHA_EMBEDDING_BASE_URL=
DISHA_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
DISHA_EMBEDDING_TIMEOUT_MS=3000
DISHA_EMBEDDING_API_KEY=

# ---------------------------------------------------------------------------
# Scheduler
# ---------------------------------------------------------------------------
DISHA_SCHEDULER_POLL_SECONDS=30
DISHA_RUNTIME_EVENT_STREAM=disha:runtime-events

# ---------------------------------------------------------------------------
# OSINT backend
# ---------------------------------------------------------------------------
OSIRIS_BASE_URL=http://127.0.0.1:3005
# OSINT backend API key. Required when proxying to the OSINT backend.
DISHA_OSINT_API_KEY=replace-with-a-strong-osint-api-key

# ---------------------------------------------------------------------------
# Ollama (local LLM) — optional
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_NATIVE_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_MAX_CONCURRENCY=4

# ---------------------------------------------------------------------------
# Anthropic — optional
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_VERSION=2023-06-01

# ---------------------------------------------------------------------------
# OpenAI — optional
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_PROJECT=
OPENAI_ORGANIZATION=
