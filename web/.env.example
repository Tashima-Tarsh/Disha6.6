DISHA_AUTH_MODE=dev-jwt
DISHA_JWT_SECRET=replace-with-at-least-32-random-characters
DISHA_DEV_PASSWORD=replace-with-local-password
DISHA_DEV_ADMIN_EMAILS=
DISHA_OIDC_ISSUER=
DISHA_OIDC_CLIENT_ID=
DISHA_OIDC_CLIENT_SECRET=
DISHA_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/oidc/callback
DISHA_MERI_PEHCHAN_AUTH_URL=
DISHA_INTRA_ID_AUTH_URL=
DATABASE_URL=postgresql://disha:postgres@localhost:5432/disha
REDIS_URL=redis://localhost:6379
DISHA_WORKER_TOKEN=<set-at-least-24-random-characters>
DISHA_SCHEDULER_POLL_SECONDS=30
DISHA_RUNTIME_EVENT_STREAM=disha:runtime-events
DISHA_WORKSPACE_ROOT=..
DISHA_ALLOWED_ORIGINS=http://localhost:3000
DISHA_BACKEND_URL=http://localhost:3001
DISHA_BRAIN_URL=http://localhost:8080
DISHA_BRAIN_API_TOKEN=change-me
DISHA_RESEARCH_RUNTIME_URL=
DISHA_RESEARCH_RUNTIME_TOKEN=
DISHA_RESEARCH_RUNTIME_TIMEOUT_MS=2500
DISHA_WEB_RATE_LIMIT=120
DISHA_AGENT_MODE=balanced
DISHA_AGENT_INPUT_BUDGET_TOKENS=8000
DISHA_AGENT_CACHE_TTL_SECONDS=3600
DISHA_AGENT_MAX_CACHE_BYTES=250000
DISHA_WORKFLOW_NODE_TIMEOUT_MS=15000
DISHA_WORKFLOW_TOTAL_TIMEOUT_MS=60000
DISHA_WORKFLOW_ALLOWED_HOSTS=localhost:3001,localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
# Production: set this to your real public URL so share links and other created URLs are correct.
# This is the source of truth for "create url" endpoints (e.g. share creation) to produce production-level unique links.
# Do NOT leave as localhost in production.
NEXT_PUBLIC_APP_URL=https://disha.your-production-domain.com
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional live model router. Prefer setting this via /api/v1/runtime/model-routes in production.
# Each route references an API key ENV NAME; secrets never belong in the JSON.
DISHA_MODEL_ROUTES_JSON=
DISHA_MODEL_ROLE=analysis
OPENAI_PROJECT=
OPENAI_ORGANIZATION=

# Public-data adapter identification/contact (no secrets)
SEC_USER_AGENT=DISHA/6.6 contact@example.org
OPENALEX_MAILTO=contact@example.org
