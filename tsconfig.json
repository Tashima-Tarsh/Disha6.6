{
  "extends": "./web/tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./web/*"]
    }
  },
  "include": [
    "web/next-env.d.ts",
    "web/app/**/*.ts",
    "web/app/**/*.tsx",
    "web/lib/server/**/*.ts",
    "web/lib/types.ts",
    "web/lib/utils.ts",
    "web/lib/share-store.ts",
    "web/lib/export/**/*.ts",
    "web/services/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "disha",
    "src",
    "web/node_modules",
    "web/.next"
  ]
}
