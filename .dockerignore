# Dependencies (rebuilt in container)
node_modules
**/node_modules
.venv
**/.venv
__pycache__
**/*.pyc

# Git metadata
.git
.github
.gitignore

# Build output (rebuilt in container)
dist
**/dist

# Env files — never bake secrets into the image
.env
.env.*
!.env.example

# Logs and debug
*.log
**/logs/*.log
npm-debug.log*
bun-debug.log*

# Test artifacts
coverage
.nyc_output
.pytest_cache
.ruff_cache

# Editor / OS noise
.DS_Store
Thumbs.db
.vscode
.idea

# AI checkpoints and data
disha/services/ai-platform/backend/checkpoints
disha/services/cyber/logs
*.pt
*.pth
*.mlmodel
*.h5

# Keep production root-context Docker builds lean. The web image uses ./web
# as its own context and bundles the necessary agents there in release CI.
# Dedicated Pentagi builds use the isolated upstream context.
/.agents/
/disha/legacy-root-src/
/disha/services/integrations/Pentagi/
/gateway/
/docs/
/reports/
/frontend/
