{
  "name": "@tashima-tarsh/disha6.6",
  "version": "6.6.0",
  "description": "disha6.6 Constitutional Evidence Operating System: evidence-first governance intelligence with policy gates and provenance.",
  "license": "MIT",
  "author": "Nitish Kumar (thenitishkr) <https://thenitishkr.in>",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "start": "npm --prefix web run start",
    "test": "npm --prefix web run test",
    "test:python": "node scripts/test-python.mjs",
    "type-check": "npm --prefix web run type-check",
    "audit": "npm --prefix web audit --audit-level=moderate",
    "governance": "node scripts/governance-check.mjs",
    "external:sync": "node scripts/sync-external-intelligence.mjs",
    "external:status": "node scripts/sync-external-intelligence.mjs --status",
    "external:runtime": "node scripts/external-runtime.mjs --status",
    "external:up": "node scripts/external-runtime.mjs --up pentagi-ui",
    "docker:dev": "docker compose up --build web",
    "docker:full": "docker compose --profile full up --build",
    "docker:prod": "docker compose -f docker-compose.prod.yml up",
    "osint:discover": "node scripts/osint/discover-upstreams.mjs",
    "osint:verify": "node scripts/osint/verify-upstreams.mjs",
    "osint:fork": "node scripts/osint/fork-upstreams.mjs",
    "osint:classify": "node scripts/osint/classify-upstreams.mjs",
    "osint:build": "node scripts/osint/build-tools.mjs",
    "osint:smoke": "node scripts/osint/smoke-tool.mjs",
    "osint:smoke-all": "node scripts/osint/smoke-all.mjs",
    "osint:health": "node scripts/osint/smoke-all.mjs",
    "osint:report": "node scripts/osint/report.mjs",
    "osint:bootstrap": "node scripts/osint/bootstrap.mjs",
    "verify": "npm --prefix web run type-check:full && npm --prefix web run test && npm --prefix web run build"
  },
  "engines": {
    "node": "22.x"
  }
}
