{
  "displayName": "DISHA 6.6 Sovereign Command & Telemetry Center",
  "gridLayout": {
    "columns": "2",
    "widgets": [
      {
        "title": "DISHA Sovereign Defense Operations Overview",
        "text": {
          "content": "# DISHA 6.6 Sovereign Telemetry Center\n\n**Environment**: Production (Google Cloud Platform)\n**Host**: `disha-os-core` (`35.244.9.142` in `asia-south1-a` Mumbai)\n**Security Model**: Constitutional Policy Gate (No-First-Use) + SHA-256 Hash-Chain Evidence Ledger\n**Microservices Tier**: 8 Distributed Services (Edge, Web, Brain, Embeddings, OSINT Worker, Scheduler, PostGIS, Redis)",
          "format": "MARKDOWN"
        }
      },
      {
        "title": "Compute Engine Host CPU Utilization (%)",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"compute.googleapis.com/instance/cpu/utilization\" resource.type=\"gce_instance\"",
                  "aggregation": {
                    "perSeriesAligner": "ALIGN_MEAN",
                    "crossSeriesReducer": "REDUCE_MEAN",
                    "alignmentPeriod": "60s"
                  }
                }
              },
              "plotType": "LINE"
            }
          ],
          "yAxis": {
            "label": "CPU (%)",
            "scale": "LINEAR"
          }
        }
      },
      {
        "title": "Network Traffic Ingress (Received Bytes/sec)",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"compute.googleapis.com/instance/network/received_bytes_count\" resource.type=\"gce_instance\"",
                  "aggregation": {
                    "perSeriesAligner": "ALIGN_RATE",
                    "crossSeriesReducer": "REDUCE_SUM",
                    "alignmentPeriod": "60s"
                  }
                }
              },
              "plotType": "LINE"
            }
          ],
          "yAxis": {
            "label": "Bytes / Sec",
            "scale": "LINEAR"
          }
        }
      },
      {
        "title": "Network Traffic Egress (Sent Bytes/sec)",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"compute.googleapis.com/instance/network/sent_bytes_count\" resource.type=\"gce_instance\"",
                  "aggregation": {
                    "perSeriesAligner": "ALIGN_RATE",
                    "crossSeriesReducer": "REDUCE_SUM",
                    "alignmentPeriod": "60s"
                  }
                }
              },
              "plotType": "LINE"
            }
          ],
          "yAxis": {
            "label": "Bytes / Sec",
            "scale": "LINEAR"
          }
        }
      },
      {
        "title": "Persistent SSD Storage Read Throughput (Bytes/sec)",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"compute.googleapis.com/instance/disk/read_bytes_count\" resource.type=\"gce_instance\"",
                  "aggregation": {
                    "perSeriesAligner": "ALIGN_RATE",
                    "crossSeriesReducer": "REDUCE_SUM",
                    "alignmentPeriod": "60s"
                  }
                }
              },
              "plotType": "LINE"
            }
          ],
          "yAxis": {
            "label": "Bytes / Sec",
            "scale": "LINEAR"
          }
        }
      },
      {
        "title": "Persistent SSD Storage Write Throughput (Bytes/sec)",
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"compute.googleapis.com/instance/disk/write_bytes_count\" resource.type=\"gce_instance\"",
                  "aggregation": {
                    "perSeriesAligner": "ALIGN_RATE",
                    "crossSeriesReducer": "REDUCE_SUM",
                    "alignmentPeriod": "60s"
                  }
                }
              },
              "plotType": "LINE"
            }
          ],
          "yAxis": {
            "label": "Bytes / Sec",
            "scale": "LINEAR"
          }
        }
      }
    ]
  }
}
