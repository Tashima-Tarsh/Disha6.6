# ASTRA 6 Autonomous OSINT Execution Engine
# Governed passive/public worker: Python 3.11 + Go 1.23 + Node.js 22
FROM golang:1.23-alpine AS go-builder

RUN apk add --no-cache git gcc musl-dev

# Reproducible reviewed binary versions matching web/lib/unified/astra6-tool-manifest.ts
RUN go install -v github.com/projectdiscovery/subfinder/v2/cmd/subfinder@v2.6.6
RUN go install -v github.com/owasp-amass/amass/v4/...@v4.2.0
RUN go install -v github.com/sundowndev/phoneinfoga/v2@v2.11.0

FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    ca-certificates \
    gnupg \
    procps \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update && apt-get install -y nodejs \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY --from=go-builder /go/bin/subfinder /usr/local/bin/subfinder
COPY --from=go-builder /go/bin/amass /usr/local/bin/amass
COPY --from=go-builder /go/bin/phoneinfoga /usr/local/bin/phoneinfoga

RUN pip install --no-cache-dir \
    "git+https://github.com/sherlock-project/sherlock.git@v0.15.0" \
    "git+https://github.com/laramies/theHarvester.git@4.6.0" \
    psycopg2-binary

# SpiderFoot is executed in passive mode only. Pin the reviewed release instead of tracking main.
RUN git clone --depth 1 --branch v4.0 https://github.com/smicallef/spiderfoot.git /opt/spiderfoot \
    && pip install --no-cache-dir -r /opt/spiderfoot/requirements.txt \
    && rm -rf /opt/spiderfoot/.git

WORKDIR /opt/disha-worker

COPY web/package.json ./package.json
COPY web/scripts/astra6-worker.mjs ./scripts/astra6-worker.mjs
COPY web/lib ./lib

# tsx is a production runtime dependency here because the worker imports the same
# governed TypeScript manifests/parsers used by the web control plane.
RUN npm install --omit=dev pg redis tsx

RUN useradd -u 10002 -m -s /bin/bash disha-worker \
    && chown -R disha-worker:disha-worker /opt/disha-worker /opt/spiderfoot

USER disha-worker

ENV NODE_ENV=production
ENV DISHA_WORKER_RUNTIME=astra6-dedicated

CMD ["./node_modules/.bin/tsx", "scripts/astra6-worker.mjs"]
