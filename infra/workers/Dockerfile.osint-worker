# ASTRA 6 Autonomous OSINT Execution Engine
# Hardened multi-runtime container: Python 3.11 + Go 1.23 + Node.js 22 LTS
FROM golang:1.23-alpine AS go-builder

# Install ProjectDiscovery Subfinder, OWASP Amass, and PhoneInfoga binaries
RUN apk add --no-cache git gcc musl-dev

# Install subfinder
RUN go install -v github.com/projectdiscovery/subfinder/v2/cmd/subfinder@latest

# Install amass
RUN go install -v github.com/owasp-amass/amass/v4/...@master || true

# Install phoneinfoga
RUN go install -v github.com/sundowndev/phoneinfoga/v2@latest || true

# Final Production Worker Image
FROM python:3.11-slim

# Install system dependencies, Node.js 22, and git
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    ca-certificates \
    gnupg \
    procps \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list \
    && apt-get update && apt-get install -y nodejs \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Copy Go binaries from builder
COPY --from=go-builder /go/bin/subfinder /usr/local/bin/subfinder
COPY --from=go-builder /go/bin/amass /usr/local/bin/amass
COPY --from=go-builder /go/bin/phoneinfoga /usr/local/bin/phoneinfoga

# Install Sherlock and theHarvester via pip
RUN pip install --no-cache-dir \
    sherlock-project \
    theHarvester \
    psycopg2-binary

WORKDIR /opt/disha-worker

# Copy application files needed for worker
COPY web/scripts/astra6-worker.mjs ./scripts/astra6-worker.mjs

# Install minimal Node runtime dependencies for worker
RUN npm init -y >/dev/null 2>&1 && npm install --omit=dev pg@8.20.0 redis@6.0.1

# Security: run as unprivileged worker user
RUN useradd -u 10002 -m -s /bin/bash disha-worker \
    && chown -R disha-worker:disha-worker /opt/disha-worker

USER disha-worker

ENV NODE_ENV=production
ENV DISHA_WORKER_RUNTIME=astra6-dedicated

CMD ["node", "scripts/astra6-worker.mjs"]
