# DISHA 6.6 — Dedicated Cyber Threat Intelligence (CTI) Worker
# Capabilities: CISA KEV sync, CVE/NVD vulnerability enrichment, EPSS scoring, STIX/IOC correlation
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates gnupg procps \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list \
    && apt-get update && apt-get install -y nodejs \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    requests==2.31.0 \
    psycopg2-binary==2.9.9

WORKDIR /opt/disha-worker
COPY web/package.json ./package.json
COPY web/scripts/astra6-worker.mjs ./scripts/astra6-worker.mjs
COPY web/lib ./lib
RUN npm install --omit=dev pg redis @google-cloud/pubsub

RUN useradd -u 10006 -m -s /bin/bash disha-cti-worker \
    && chown -R disha-cti-worker:disha-cti-worker /opt/disha-worker
USER disha-cti-worker

ENV NODE_ENV=production \
    WORKER_CLASS=cti \
    TMPDIR=/tmp
ENTRYPOINT ["node", "scripts/astra6-worker.mjs"]
