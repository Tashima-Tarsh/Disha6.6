# DISHA 6.6 — Dedicated Identity OSINT Worker
# Capabilities: PhoneInfoga, Sherlock, public numbering & username discovery
FROM golang:1.23-alpine AS go-builder
RUN apk add --no-cache git gcc musl-dev
# Pinned version for PhoneInfoga
RUN go install -v github.com/sundowndev/phoneinfoga/v2@v2.11.0

FROM python:3.11-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates gnupg procps \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list \
    && apt-get update && apt-get install -y nodejs \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY --from=go-builder /go/bin/phoneinfoga /usr/local/bin/phoneinfoga

# Pinned Python dependencies for identity discovery
RUN pip install --no-cache-dir \
    sherlock-project==0.15.0 \
    maigret==0.6.6 \
    holehe==1.61 \
    instaloader==4.15.3 \
    Telethon==1.45.0 \
    psycopg2-binary==2.9.9

WORKDIR /opt/disha-worker
COPY web/scripts/astra6-worker.mjs ./scripts/astra6-worker.mjs
COPY web/scripts/identity-osint-adapter.py ./scripts/identity-osint-adapter.py
RUN npm init -y >/dev/null 2>&1 && npm install --omit=dev pg@8.20.0 redis@6.0.1

# Security: Non-root user, no-new-privileges, ephemeral /tmp
RUN useradd -u 10003 -m -s /bin/bash disha-identity-worker \
    && chown -R disha-identity-worker:disha-identity-worker /opt/disha-worker
USER disha-identity-worker

ENV NODE_ENV=production \
    WORKER_CLASS=identity \
    TMPDIR=/tmp
ENTRYPOINT ["node", "scripts/astra6-worker.mjs"]
