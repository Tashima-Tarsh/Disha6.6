# DISHA 6.6 — Dedicated Identity OSINT Worker
# Capabilities: PhoneInfoga, Sherlock, public numbering & username discovery
# PhoneInfoga embeds a built web client, so its Go module cannot be installed
# reliably with `go install`. Reuse the upstream release image built from the
# tagged source and copy only its compiled CLI into the DISHA runtime.
FROM sundowndev/phoneinfoga:v2.11.0 AS phoneinfoga

FROM python:3.11-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates gnupg procps \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list \
    && apt-get update && apt-get install -y nodejs \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY --from=phoneinfoga /app/phoneinfoga /usr/local/bin/phoneinfoga

# Keep upstream OSINT tools isolated: they evolve independently and may
# require conflicting transitive dependencies.
RUN python -m venv /opt/venvs/sherlock \
    && /opt/venvs/sherlock/bin/pip install --no-cache-dir sherlock-project==0.15.0 \
    && python -m venv /opt/venvs/maigret \
    && /opt/venvs/maigret/bin/pip install --no-cache-dir maigret==0.6.6 \
    && python -m venv /opt/venvs/holehe \
    && /opt/venvs/holehe/bin/pip install --no-cache-dir holehe==1.61 \
    && python -m venv /opt/venvs/instaloader \
    && /opt/venvs/instaloader/bin/pip install --no-cache-dir instaloader==4.15.3 \
    && python -m venv /opt/venvs/telethon \
    && /opt/venvs/telethon/bin/pip install --no-cache-dir Telethon==1.45.0

WORKDIR /opt/disha-worker
COPY web/scripts/astra6-worker.mjs ./scripts/astra6-worker.mjs
COPY web/scripts/identity-osint-adapter.py ./scripts/identity-osint-adapter.py
RUN npm init -y >/dev/null 2>&1 && npm install --omit=dev pg@8.20.0 redis@6.0.1

# Security: Non-root user, no-new-privileges, ephemeral /tmp
RUN useradd -u 10003 -m -s /bin/bash disha-identity-worker \
    && chown -R disha-identity-worker:disha-identity-worker /opt/disha-worker
USER disha-identity-worker

ENV NODE_ENV=production \
    WORKER_CLASS=identity \
    TMPDIR=/tmp
ENTRYPOINT ["node", "scripts/astra6-worker.mjs"]
