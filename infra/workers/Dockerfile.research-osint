# DISHA 6.6 — Advanced upstream OSINT worker
# Runs pinned source trees for SpiderFoot, Recon-ng and Photon.
FROM python:3.10-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cargo rustc curl ca-certificates gnupg libffi-dev libssl-dev \
    libxml2-dev libxslt1-dev zlib1g-dev libjpeg-dev procps \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

COPY disha/services/integrations/osint-upstreams/spiderfoot /opt/osint/spiderfoot
COPY disha/services/integrations/osint-upstreams/recon-ng /opt/osint/recon-ng
COPY disha/services/integrations/osint-upstreams/recon-ng-marketplace /opt/osint/recon-ng-marketplace
COPY disha/services/integrations/osint-upstreams/Photon /opt/osint/photon

RUN python -m venv /opt/venvs/spiderfoot \
    && /opt/venvs/spiderfoot/bin/pip install --no-cache-dir --upgrade pip wheel setuptools \
    && /opt/venvs/spiderfoot/bin/pip install --no-cache-dir -r /opt/osint/spiderfoot/requirements.txt \
    && python -m venv /opt/venvs/recon \
    && /opt/venvs/recon/bin/pip install --no-cache-dir --upgrade pip wheel setuptools \
    && /opt/venvs/recon/bin/pip install --no-cache-dir -r /opt/osint/recon-ng/REQUIREMENTS \
    && python -m venv /opt/venvs/photon \
    && /opt/venvs/photon/bin/pip install --no-cache-dir --upgrade pip wheel setuptools \
    && /opt/venvs/photon/bin/pip install --no-cache-dir -r /opt/osint/photon/requirements.txt

WORKDIR /opt/disha-worker
COPY web/scripts/astra6-worker.mjs ./scripts/astra6-worker.mjs
COPY web/scripts/recon-ng-adapter.py ./scripts/recon-ng-adapter.py
RUN npm init -y >/dev/null 2>&1 && npm install --omit=dev pg@8.20.0 redis@6.0.1

RUN useradd -u 10005 -m -s /bin/bash disha-advanced-worker \
    && mkdir -p /var/lib/spiderfoot /tmp/disha-photon \
    && chown -R disha-advanced-worker:disha-advanced-worker /opt/disha-worker /opt/osint /var/lib/spiderfoot /tmp/disha-photon

USER disha-advanced-worker
ENV NODE_ENV=production \
    WORKER_CLASS=advanced \
    SPIDERFOOT_DATA=/var/lib/spiderfoot \
    SPIDERFOOT_LOGS=/tmp \
    SPIDERFOOT_CACHE=/tmp \
    TMPDIR=/tmp
ENTRYPOINT ["node", "scripts/astra6-worker.mjs"]
