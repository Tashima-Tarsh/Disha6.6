# DISHA 6.6 — Dedicated Infrastructure OSINT Worker
# Capabilities: Subfinder, OWASP Amass (passive), theHarvester (passive), DNS intelligence
FROM golang:1.23-alpine AS go-builder
RUN apk add --no-cache git gcc musl-dev
RUN go install -v github.com/projectdiscovery/subfinder/v2/cmd/subfinder@v2.6.6
RUN go install -v github.com/owasp-amass/amass/v4/...@v4.2.0

FROM python:3.11-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates gnupg procps \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list \
    && apt-get update && apt-get install -y nodejs \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY --from=go-builder /go/bin/subfinder /usr/local/bin/subfinder
COPY --from=go-builder /go/bin/amass /usr/local/bin/amass

RUN pip install --no-cache-dir \
    theHarvester==4.6.0 \
    psycopg2-binary==2.9.9

WORKDIR /opt/disha-worker
COPY web/scripts/astra6-worker.mjs ./scripts/astra6-worker.mjs
RUN npm init -y >/dev/null 2>&1 && npm install --omit=dev pg@8.20.0 redis@6.0.1

RUN useradd -u 10004 -m -s /bin/bash disha-infra-worker \
    && chown -R disha-infra-worker:disha-infra-worker /opt/disha-worker
USER disha-infra-worker

ENV NODE_ENV=production \
    WORKER_CLASS=infrastructure \
    TMPDIR=/tmp
ENTRYPOINT ["node", "scripts/astra6-worker.mjs"]
